+/** The `count` artifacts the page's Recent order puts first. */
+export function latestArtifacts(
+  list: readonly ArtifactSummary[],
+  opened: OpenedTimes,
+  count: number,
+): ArtifactSummary[] {
+  return [...list]
+    .sort((a, b) => recency(b, opened) - recency(a, opened) || a.id.localeCompare(b.id))
+    .slice(0, count)
+}
